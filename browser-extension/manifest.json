{
  "manifest_version": 3,
  "name": "json4matter — JSON 格式化查看器",
  "version": "0.0.1",
  "description": "浏览器版 JSON 格式化查看器（复刻 WPF json4matter）。自动解包接口日志中的转义 JSON 字符串，树形着色、搜索、折叠标数、复制/压缩、隐藏空值、三套主题。",
  "action": {
    "default_popup": "index.html",
    "default_title": "json4matter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "index.html?panel=1"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "sidePanel"
  ]
}
